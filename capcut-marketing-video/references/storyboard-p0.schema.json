{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketing portrait storyboard P0",
  "type": "object",
  "required": [
    "version",
    "duration",
    "canvas",
    "script",
    "assets",
    "shots",
    "captions",
    "audio",
    "source_text",
    "narration"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "copy_notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "narration": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "provided",
            "native_tts",
            "source"
          ]
        },
        "timing": {
          "enum": [
            "estimated",
            "aligned"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "provided",
                  "native_tts",
                  "source"
                ]
              }
            }
          },
          "then": {
            "required": [
              "timing"
            ]
          }
        },
        {
          "if": {
            "required": [
              "timing"
            ],
            "properties": {
              "timing": {
                "const": "aligned"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        }
      ]
    },
    "delivery": {
      "enum": [
        "draft",
        "draft+native",
        "video-only"
      ],
      "default": "draft+native"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "fps": {
          "const": 30
        }
      },
      "oneOf": [
        {
          "properties": {
            "width": {
              "const": 1080
            },
            "height": {
              "const": 1920
            }
          }
        },
        {
          "properties": {
            "width": {
              "const": 720
            },
            "height": {
              "const": 1280
            }
          }
        }
      ]
    },
    "script": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pause_after": {
            "type": "number",
            "minimum": 0
          },
          "purpose": {
            "type": "string"
          },
          "emphasis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dependentRequired": {
          "start": [
            "end"
          ],
          "end": [
            "start"
          ]
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "kind",
          "inspection"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "video",
              "audio",
              "image"
            ]
          },
          "inspection": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "original_audio": {
            "enum": [
              "none",
              "speech",
              "music",
              "ambient"
            ]
          },
          "audio_action": {
            "enum": [
              "mute",
              "keep",
              "duck"
            ]
          },
          "burned_text": {
            "enum": [
              "none",
              "present"
            ]
          },
          "text_action": {
            "enum": [
              "none",
              "avoid",
              "crop",
              "cover",
              "keep-approved"
            ]
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mediaSegment"
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/mediaSegment"
          }
        ],
        "required": [
          "role",
          "volume",
          "source_in",
          "source_out"
        ],
        "properties": {
          "role": {
            "enum": [
              "narration",
              "bgm",
              "sfx"
            ]
          },
          "fade_in": {
            "type": "number",
            "minimum": 0
          },
          "fade_out": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "start",
          "end",
          "recipe",
          "visual"
        ],
        "oneOf": [
          {
            "required": [
              "cue_id"
            ],
            "not": {
              "required": [
                "cue_ids"
              ]
            }
          },
          {
            "required": [
              "cue_ids"
            ],
            "not": {
              "required": [
                "cue_id"
              ]
            }
          }
        ],
        "properties": {
          "cue_ids": {
            "$ref": "#/$defs/cueIds"
          },
          "cue_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "recipe": {
            "enum": [
              "keyword-reveal",
              "editorial-stack",
              "benefit-tag",
              "number-focus",
              "cta-lockup"
            ]
          },
          "visual": {
            "type": "object",
            "required": [
              "fontSize",
              "color",
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "fontSize": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "font": {
                "type": "object"
              }
            }
          },
          "animation": {
            "type": "object",
            "properties": {
              "intro": {
                "type": "string"
              },
              "outro": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "intro_seconds": {
                "type": "number",
                "minimum": 0
              },
              "outro_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bubble": {
            "type": "object",
            "required": [
              "text",
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    },
    "style_exceptions": {
      "type": "object",
      "properties": {
        "keywords_reason": {
          "type": "string",
          "minLength": 1
        },
        "bubble_reason": {
          "type": "string",
          "minLength": 1
        },
        "animation_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "cueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mediaSegment": {
      "type": "object",
      "required": [
        "asset_id",
        "start",
        "end"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "cue_ids": {
          "$ref": "#/$defs/cueIds"
        },
        "match_reason": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_in": {
          "type": "number",
          "minimum": 0
        },
        "source_out": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
